# Bybit API (只读权限即可, 需统一账户持仓读取权限)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# 是否使用测试网 (true/false)
BYBIT_TESTNET=false

# 网络代理: 若 Bybit / Telegram 直连被墙, 填写本地代理地址 (服务端需填写自己的代理)
# 支持 http / socks5 代理, 例如:
HTTPS_PROXY=http://127.0.0.1:1088

# Telegram bot token (通过 @BotFather 获取)
TG_BOT_TOKEN=
# 目标频道 / 群 / 用户: 频道为 @频道用户名 或数字 id
TG_CHAT_ID=
