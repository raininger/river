# 回撤止盈哨兵配置。复制为 .env.sentinel 后填写。
#
#   注意: .env.sentinel 里是【带交易权限】的 API key, 已在 .gitignore 中忽略,
#   请勿提交到仓库, 也不要和只读的日报 .env 共用一个 key。
#
#   策略: 空单先「武装」(跌幅够 A), 之后一路记录最低价, 等价格自最低点反弹够 B
#   再市价平仓。买的是「反弹已经发生」这个事实, 而不是「跌不动了」这个预测——
#   下跌是阶梯式的, 中途的停顿极具欺骗性, 拿来当离场信号会反复卖在半山腰。
#
#   先用默认的 dry-run 跑一段时间验证判定是否准确, 确认后再:
#       ./bin/sentinel -dry-run=false

# ---- Bybit API (需要「合约 - 交易」权限; 建议不要勾选提币权限) ----
BYBIT_API_KEY=
BYBIT_API_SECRET=
# 先在测试网用真实下单路径验证一遍, 再上主网
BYBIT_TESTNET=false

# 网络代理: 若 Bybit / Telegram 直连被墙, 填写本地代理地址
HTTPS_PROXY=http://127.0.0.1:1088

# ---- Telegram ----
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---- 轮询与执行 ----
# 轮询持仓的间隔
POLL_INTERVAL=15s
# 浮盈门槛(%), 0 表示只要浮盈为正就允许平仓。浮盈是必要条件: 任何情况下都不会
# 用市价单去平一个浮亏的仓位
MIN_PROFIT_PCT=0
# 单轮最多下多少个平仓单, 超出的留到下一轮。全市场跳水时防止瞬间打满下单限频
MAX_ORDERS_PER_CYCLE=10
# 相邻两个平仓单之间的最小间隔(Bybit 下单限频为 10 单/秒/UID)
ORDER_MIN_GAP=150ms
# dry-run 模式下, 同一品种多久内只告警一次, 避免刷屏
ALERT_COOLDOWN=30m

# ---- A: 武装阈值(现价相对窗口内最高价的回撤) ----
# 回看窗口。至少要 POLL_INTERVAL 的 4 倍, 启动时会校验
#
# 用「窗口内最高价回撤」而不是「现价 vs N 分钟前」: 后者只比较窗口两端,
# 缓慢阴跌(每个轮询只跌一点点)永远凑不出足够的落差, 而那正是暴跌的常见形态。
#
# 窗口长度决定「什么形态的下跌算暴跌」: 1h 只算单根腿, 慢跌(每小时跌 1%、
# 连跌几小时)装不进来; 4h 连慢跌也能装下。默认 4h。
#
# 它还顺带决定了 A 与 B 的相对大小, 这一条比看上去重要: B 只随波动率走, A 还随
# 窗口变长而变大(随机游走下回撤幅度约按 √窗口 增长)。用 30 天小时线实测:
#   1h 窗口 → A ≈ 1.2 × B     A 和 B 差不多大, 等于在噪声里平仓
#   4h 窗口 → A ≈ 2.6 × B     A 明显大于 B 才是「暴跌后等反弹」
DROP_WINDOW=4h

# 自适应武装阈值 A: 取「窗口内回撤」在该品种过去 30 天分布中的这个分位,
# 即【这个品种自己最猛的那 0.5% 的下跌】。0 表示关闭自适应, 一律用 DROP_PCT。
#
# 为什么不用「k × 标准差」定义暴跌: σ 是拿最近几天算的, 暴跌当天它自己被暴跌
# 抬上去好几倍, 尺子跟着变长, 于是越暴力的暴跌越量不出来(一次 7% 的下跌配上
# 抬升 5 倍的 σ 反而够不着阈值), 永远不武装。分位数不受这个污染——一场暴跌
# 只是几百个样本里的几个, 抬不动分位数。它也不假设收益正态, 而加密是厚尾的。
#
# 100+ 个品种的波动率差一个数量级, 同一个百分比在 BTC 上是暴跌、在次新 meme 上
# 只是日常波动, 所以默认走自适应。上市不足约 30 天的品种样本不够, 会自动退回
# DROP_PCT, 启动日志里会逐个列出来——那些品种记得用 OVERRIDES 单独设。
ARM_QUANTILE=0.995

# 固定的武装阈值 A(%): 关闭自适应或样本不足时的兜底值, 也是逐品种覆盖的默认值
DROP_PCT=3.0

# ---- B: 反弹阈值(自武装以来最低点反弹多少平仓) ----
# 全局固定 B; 留 0 表示由波动率自动计算, 这也是默认行为——
# 100+ 个品种的波动率能差一个数量级, 一个固定值必然在某些品种上过紧
# (被噪音甩出去)、在另一些上过松(回吐太多)。
REBOUND_PCT=0
# 自动模式: B = VOL_MULT × σ, σ 是该品种单根小时 K 线的收益率标准差
VOL_MULT=2.0
# σ 的回看时长。用 1 小时 K 线而不是日线, 是因为日线一天才更新一次,
# 暴跌当天完全感知不到——而那正是最需要 B 变宽的时候。当天已走完的小时会被
# 计入, σ 随暴跌自动抬升、B 自动变宽; 动能衰竭后波动回落, B 自动收窄。
# 7 天(168 根)足够稳定, 又保留约一周的市场状态记忆; 14 天更平滑但对
# 状态切换反应更慢, 且暴跌对 σ 的抬升幅度只剩一半左右。
VOL_LOOKBACK=168h
# B 的下限(%), 防止做市/稳定币这类极低波动品种触发过紧
VOL_FLOOR_PCT=0.5
# K 线不足(新上市)或接口失败时的兜底 B(%)
REBOUND_FALLBACK_PCT=2.0

# ---- 逐品种覆盖(可选), 逗号分隔 SYMBOL:数值 ----
# 固定 A, 压过自适应分位数。只在两种情况下需要: ① 上市太新、样本不足被退回了
# DROP_PCT 的品种; ② 分位数算出来的值你不认同。不填则全部走自适应
OVERRIDES=ETHUSDT:2.0,DOGEUSDT:8.0
# 只覆盖 B; 填了的品种完全按这个固定值走, 不再用波动率自动算
REBOUND_OVERRIDES=
